#!/bin/bash
set -u -e -C;
shopt -s nullglob failglob

# run diff ignoring its exit code.
function diff { command diff "$@" || true; }


# Load environment from file (twice).  Compare printing the
# environment without fenv, and with fenv.

# keep only entries whose name contains an `X`, except for those whose
# value is a number:

env -i -S "$(< "${repo}/tests/env")" \
    "${fenv}" -vE '^[[:digit:]]*$' -knG '*X*' \
    -- env
